# ATIKVIEWER ortam değişkenleri şablonu.
# Kullanım: cp .env.example .env  (ardından değerleri doldurun)
# Bu dosya güvenlidir (gerçek sır içermez) ve GitHub'a commit'lenir.

# Zorunlu: PostgreSQL bağlantısı (Drizzle ORM buradan okur)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Önerilen (üretimde zorunlu tutun): alan düzeyi AES-256-GCM şifreleme anahtarı (base64, 32 bayt).
# Üretim: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Boş bırakılırsa uygulama .data/enc.key dosyasını otomatik üretir (tek sunucu için yeterli).
DATA_ENCRYPTION_KEY=

# İsteğe bağlı: PACS (DICOMweb) kimlik başlığı, örn. "Basic dXNlcjpwYXNz"
PACS_AUTH_HEADER=

# İsteğe bağlı: HBYS/RIS istem alımı API anahtarı (/api/his/orders, x-api-key başlığı)
HIS_API_KEY=

# İsteğe bağlı: taslak izlenim için OpenAI uyumlu LLM uç noktası (yoksa kural tabanlı yedek çalışır)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
